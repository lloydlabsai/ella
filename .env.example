# ─── Supabase (required) ─────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Anthropic (for local dev without edge functions) ─────
# In production, the edge function proxy handles this.
# Only needed for local dev or Claude.ai artifacts.
VITE_ANTHROPIC_API_KEY=

# ─── Tavily (for local dev without edge functions) ────────
VITE_TAVILY_API_KEY=

# ─── Perplexity (for local dev without edge functions) ────
VITE_PERPLEXITY_API_KEY=

# ─── Generation limits (optional) ────────────────────────
# Self-hosting bills your own Anthropic key, so generations are
# UNLIMITED by default. Only set these if you run a hosted instance
# and want to meter users. 0 or unset = unlimited.
VITE_FREE_GENERATION_LIMIT=0
VITE_PAID_GENERATION_LIMIT=0

# ─── Supabase Edge Function Secrets ──────────────────────
# Set these as Supabase secrets, NOT in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set TAVILY_API_KEY=tvly-...
#   supabase secrets set PERPLEXITY_API_KEY=pplx-...
#
# To meter a hosted instance, mirror the limits server-side:
#   supabase secrets set FREE_GENERATION_LIMIT=3
#   supabase secrets set PAID_GENERATION_LIMIT=50
